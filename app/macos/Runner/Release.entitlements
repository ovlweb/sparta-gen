<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No App Sandbox: the app runs its engine (bundled in Contents/Resources/engine), which reads the videos
	     you open and writes renders where you save them. SpartaGen is not distributed through the App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
